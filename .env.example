# Copy this file to .env and fill in real values before running `make dev`.
# Nested settings use `__` as the delimiter (e.g. QDRANT__HOST).

# --- App ---
ENVIRONMENT=development                       # development | staging | production
LOG_LEVEL=INFO

# --- Secrets ---
ANTHROPIC_API_KEY=sk-ant-...                  # required; app fails fast at startup if missing
OPENAI_API_KEY=sk-...                         # required for default embeddings (text-embedding-3-small)

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_obs
POSTGRES_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-long-random-value
MINIO_ROOT_USER=replace-with-a-local-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-value

# --- Provider-neutral OIDC resource server ---
AUTH__ENABLED=false
AUTH__ISSUER=https://identity.example.com/
AUTH__AUDIENCE=https://rag-api.example.com
AUTH__JWKS_URI=https://identity.example.com/.well-known/jwks.json
AUTH__ALGORITHMS=["RS256"]
AUTH__ROLES_CLAIM=roles
AUTH__ORGANIZATION_CLAIM=org_id
AUTH__PERMISSIONS_CLAIM=permissions
AUTH__PROTECT_API_DOCS=true

# Trusted service identity for CLI ingestion (never accepted from an HTTP client)
INGESTION_SERVICE_USER_ID=ingestion-service
INGESTION_SERVICE_ORGANIZATION_ID=local-development

# --- Distributed controls (required in staging/production) ---
RATE_LIMIT__BACKEND=memory                   # memory only in development/tests; use redis otherwise
RATE_LIMIT__REDIS_URL=redis://:replace-with-a-long-random-value@localhost:6379/0
RATE_LIMIT__QUERY_PER_MINUTE=30
RATE_LIMIT__META_QUERY_PER_MINUTE=20
RATE_LIMIT__PER_IP_PER_MINUTE=120
RATE_LIMIT__MAX_CONCURRENT_PER_USER=2
RATE_LIMIT__MAX_CONCURRENT_GLOBAL=50
RESOURCES__MAX_BODY_BYTES=28311552             # includes multipart overhead for 25 MiB uploads
RESOURCES__MAX_LLM_INPUT_TOKENS=16000
RESOURCES__MAX_LLM_OUTPUT_TOKENS=2048
RESOURCES__DAILY_LLM_COST_UNITS_PER_USER=100000

# --- S3-compatible document storage (omit endpoint URL when using AWS S3) ---
OBJECT_STORAGE__ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE__REGION=us-east-1
OBJECT_STORAGE__BUCKET=rag-documents
OBJECT_STORAGE__ACCESS_KEY_ID=replace-with-a-local-access-key
OBJECT_STORAGE__SECRET_ACCESS_KEY=replace-with-a-long-random-value
OBJECT_STORAGE__MAX_UPLOAD_BYTES=26214400

# --- Qdrant ---
QDRANT__HOST=localhost
QDRANT__PORT=6333
QDRANT__COLLECTION_NAME=rag_documents
QDRANT__META_COLLECTION_NAME=rag_traces
QDRANT__VECTOR_SIZE=1536                      # matches text-embedding-3-small

# --- LLM ---
LLM__PROVIDER=anthropic                       # anthropic | openai | mock (echoes context, no API key)
LLM__MODEL=claude-sonnet-4-6
LLM__TEMPERATURE=0.0
LLM__MAX_TOKENS=2048
LLM__TIMEOUT_SECONDS=30
LLM__MAX_RETRIES=3

# --- Observability ---
OBSERVABILITY__PHOENIX_ENDPOINT=http://localhost:4317
OBSERVABILITY__ENABLE_CONSOLE_EXPORTER=false
OBSERVABILITY__SAMPLE_RATE_FOR_EVAL=0.2       # fraction of queries to evaluate with RAGAS
OBSERVABILITY__DEFECT_SIMILARITY_THRESHOLD=0.65
